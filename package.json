{
  "name": "osrs-world-map",
  "version": "1.0.0",
  "description": "Interactive Old School RuneScape world map built with Next.js and authentic game cache data",
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/osrs-world-map.git"
  },
  "keywords": [
    "osrs",
    "runescape",
    "map",
    "nextjs",
    "react",
    "leaflet",
    "gaming"
  ],
  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:with-tiles": "npm run clean && ./scripts/generate-tiles.sh && next build",
    "clean": "rm -rf generated_images/ public/tiles/ cache/ .next/",
    "start": "next start",
    "lint": "next lint",
    "check-dimensions": "./scripts/check-dimensions.sh",
    "explore-worldmap": "./scripts/explore-worldmap-data.sh"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet-canvas-marker": "^0.2.0",
    "next": "^15.5.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^15.5.23",
    "postcss": "8.5.26",
    "tailwindcss": "^3.3.0",
    "ts-node": "^10.9.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.26",
    "tailwindcss": {
      "sucrase": {
        "glob": "^10.5.0"
      }
    },
    "sharp": "0.35.3"
  }
}